# ─── OWL-DNS-Synergy Environment Variables ───────────────────────────
# Copy to /etc/owl-dns-synergy/env and set values

# ── Crypto ──
LLM_PROXY_KEY=

# ── Router ──
SYNERGY_LOG_LEVEL=info
SYNERGY_CACHE_TTL=300
SYNERGY_CACHE_MAX=1000

# ── Prometheus ──
SYNERGY_METRICS_PORT=9090

# ── Redis (optional) ──
SYNERGY_REDIS_URL=redis://localhost:6379
